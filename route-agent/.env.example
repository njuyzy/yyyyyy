# Only load this on the SERVER. Never put these provider secrets in local.properties / APK.
AGENT_LLM_BASE_URL=https://api.openai.com/v1
AGENT_LLM_PROTOCOL=responses
AGENT_LLM_MODEL=your-tool-capable-model-id
AGENT_LLM_API_KEY=your-server-model-key
# Separate AMAP "Web 服务" key, not the Android SDK key.
AMAP_WEB_API_KEY=your-server-amap-web-key
# Trusted backend GET endpoint: verifies Authorization and returns {"accountId":123}
# or {"code":1,"data":{"accountId":123}}. Never point at a public account profile.
AGENT_AUTH_URL=https://your-backend.example/login/me
# Direct loopback testing ONLY, identity=1. Leave empty on a deployed service.
AGENT_DEV_TOKEN=

<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- 透明状态栏，由 DisplayCutoutAdapter 给内容加顶部安全区，避免被电量/时间挡住 -->
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@android:color/transparent</item>

        <!-- Customize your theme here. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Widget.Japp.CompactToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:minHeight">@dimen/compact_toolbar_height</item>
        <item name="android:background">@color/white</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="contentInsetStartWithNavigation">0dp</item>
        <item name="navigationIconTint">@color/black</item>
        <item name="titleTextColor">@color/black</item>
        <item name="titleTextAppearance">@style/TextAppearance.Japp.CompactToolbar.Title</item>
    </style>

    <style name="TextAppearance.Japp.CompactToolbar.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Japp.CompactBottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:minHeight">@dimen/compact_bottom_nav_height</item>
        <item name="itemIconSize">22dp</item>
        <item name="itemPaddingTop">4dp</item>
        <item name="itemPaddingBottom">3dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Japp.BottomNavigation.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Japp.BottomNavigation.Inactive</item>
    </style>

    <style name="TextAppearance.Japp.BottomNavigation.Active" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Japp.BottomNavigation.Inactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
    </style>

    <!-- 登录注册按钮样式 -->
    <style name="Widget.MaterialComponents.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:padding">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">28dp</item>
        <item name="hintTextColor">?attr/colorOnSurface</item>
        <item name="elevation">4dp</item>
    </style>

    <!-- 取消按钮样式 -->
    <style name="Widget.MaterialComponents.Button.Outlined.Primary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">28dp</item>
        <item name="hintTextColor">?attr/colorOnSurface</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- 验证码按钮样式 -->
    <style name="Widget.MaterialComponents.Button.Outlined.Verification" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">20dp</item>
        <item name="hintTextColor">?attr/colorOnSurface</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- 输入字段样式 -->
    <style name="Widget.MaterialComponents.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="hintTextColor">?attr/colorOnSurface</item>
        <item name="errorTextColor">?attr/colorError</item>
    </style>

    <!-- 项目内通用的浅灰填充输入框：与登录、资料等页面保持一致。 -->
    <style name="Widget.Japp.TextInput.Filled" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxBackgroundMode">filled</item>
        <item name="boxBackgroundColor">#F5F6FA</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@android:color/transparent</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintEnabled">true</item>
        <item name="errorTextColor">?attr/colorError</item>
    </style>

    <style name="Widget.Japp.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.FilledBox">
        <item name="android:textColor">@color/route_text_primary</item>
        <item name="android:textColorHint">@color/route_text_hint</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <!-- 复选框样式 -->
    <style name="Widget.App.CheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="buttonTint">@color/accent</item>
    </style>

</resources>

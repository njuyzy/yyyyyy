<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:fillViewport="true" android:background="#FFFFFF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView style="@style/UserOrderHeading" android:layout_width="0dp"
                android:layout_weight="1" android:text="发布者资料" />
            <TextView android:id="@+id/publisherProfileClose" android:layout_width="48dp"
                android:layout_height="48dp" android:gravity="center" android:text="关闭"
                android:textSize="14sp" android:textColor="#2563EB" android:clickable="true"
                android:focusable="true" android:background="?attr/selectableItemBackground" />
        </LinearLayout>
        <FrameLayout android:layout_width="80dp" android:layout_height="80dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="16dp"
            android:background="@drawable/bg_user_publisher_avatar" android:clipToOutline="true">
            <TextView android:id="@+id/publisherProfileInitial" android:layout_width="match_parent"
                android:layout_height="match_parent" android:gravity="center"
                android:textSize="28sp" android:textStyle="bold" android:textColor="#2563EB"
                android:importantForAccessibility="no" />
            <ImageView android:id="@+id/publisherProfileAvatar" android:layout_width="match_parent"
                android:layout_height="match_parent" android:scaleType="centerCrop"
                android:contentDescription="发布者头像" android:visibility="gone" />
        </FrameLayout>
        <TextView android:id="@+id/publisherProfileName" style="@style/UserOrderHeading"
            android:layout_marginTop="12dp" android:textSize="22sp" android:gravity="center" />
        <TextView android:id="@+id/publisherProfileRegion" style="@style/UserOrderBody"
            android:layout_marginTop="8dp" android:gravity="center" />
        <ProgressBar android:id="@+id/publisherProfileLoading" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="3dp"
            android:layout_marginTop="20dp" android:indeterminate="true" android:indeterminateTint="#2563EB" />
        <TextView style="@style/UserOrderHeading" android:layout_marginTop="24dp" android:text="个人简介" />
        <TextView android:id="@+id/publisherProfileIntro" style="@style/UserOrderBody"
            android:layout_marginTop="12dp" android:textIsSelectable="true" />
        <TextView android:id="@+id/publisherProfileRetry" style="@style/UserOrderBody"
            android:layout_marginTop="12dp" android:minHeight="48dp" android:gravity="center_vertical"
            android:text="资料暂时未加载成功，点击重试" android:textColor="#2563EB"
            android:clickable="true" android:focusable="true" android:visibility="gone"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/list_page_bg"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/txtPoiOrder"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_route_search_icon"
            android:gravity="center"
            android:text="@string/route_add_symbol"
            android:textColor="@color/route_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtPoiName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/list_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="南京博物院" />

            <TextView
                android:id="@+id/txtPoiAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/list_text_secondary"
                android:textSize="13sp"
                tools:text="中山东路321号" />

            <TextView
                android:id="@+id/txtPoiType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/list_text_tertiary"
                android:textSize="11sp"
                tools:text="科教文化服务 · 博物馆" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtPoiDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/list_text_tertiary"
            android:textSize="12sp"
            tools:text="1.8 km" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

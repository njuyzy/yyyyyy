<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="3dp"
    android:paddingEnd="4dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/txtPoiOrder"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_route_search_icon"
        android:gravity="center"
        android:text="@string/route_add_symbol"
        android:textColor="@color/route_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtPoiName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/route_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="南京博物院" />

        <TextView
            android:id="@+id/txtPoiAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/route_text_secondary"
            android:textSize="11sp"
            tools:text="中山东路321号" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:background="@drawable/bg_route_ai_badge"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/route_add_stop"
        android:textColor="@color/route_primary"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>

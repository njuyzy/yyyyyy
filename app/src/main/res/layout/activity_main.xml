<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_entry_bg">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/circle_gray_background"
        android:clickable="true"
        android:contentDescription="@string/back"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_back"
        android:elevation="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#333333" />

    <!-- 平滑条容器：使用 padding 保留原有内边距（去掉 margin 以避免缩进背景） -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="24dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal|center_vertical"
            android:padding="0dp"
            android:clipToPadding="false">

            <!-- 头像动画区域 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="48dp"
                android:id="@+id/logoContainer">

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="133dp"
                    android:layout_height="99dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerCrop"
                    android:src="@drawable/login_app_icon_png"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/login_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="手机号登录"
                    android:textColor="#1A1A1A"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/logo" />

                <TextView
                    android:id="@+id/login_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:text="开启一场独属于你的美好旅程~"
                    android:textColor="#666666"
                    android:textSize="15sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/login_title"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 输入卡片 - 使用CardView美化 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#00000000"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="0dp">

                    <!-- 手机号输入 - 使用TextInputLayout -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:boxBackgroundMode="filled"
                        app:boxBackgroundColor="#F2F3F7"
                        app:boxCornerRadiusTopStart="28dp"
                        app:boxCornerRadiusTopEnd="28dp"
                        app:boxCornerRadiusBottomStart="28dp"
                        app:boxCornerRadiusBottomEnd="28dp"
                        app:boxStrokeColor="#00000000"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:errorEnabled="true"
                        app:hintEnabled="false"
                        app:prefixText="+86"
                        app:prefixTextColor="#666666"
                        app:errorTextColor="?attr/colorError">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:inputType="phone"
                            android:maxLength="11"
                            android:hint="输入手机号"
                            android:paddingStart="8dp"
                            android:textColor="#1A1A1A"
                            android:textColorHint="#999999"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 密码输入 - 使用TextInputLayout -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#666666"
                        app:boxBackgroundMode="filled"
                        app:boxBackgroundColor="#F2F3F7"
                        app:boxCornerRadiusTopStart="28dp"
                        app:boxCornerRadiusTopEnd="28dp"
                        app:boxCornerRadiusBottomStart="28dp"
                        app:boxCornerRadiusBottomEnd="28dp"
                        app:boxStrokeColor="#00000000"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:errorEnabled="true"
                        app:hintEnabled="false"
                        app:errorTextColor="?attr/colorError">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:inputType="textPassword"
                            android:hint="输入密码"
                            android:textColor="#1A1A1A"
                            android:textColorHint="#999999"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 登录按钮 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginBottom="16dp"
                        android:text="登录"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="28dp"
                        app:iconGravity="textStart"
                        style="@style/Widget.MaterialComponents.Button"
                        android:textColor="#F6FFF9"
                        app:backgroundTint="@color/accent_dark"/>

                    <!-- 选择身份区域 -->
                    <LinearLayout
                        android:id="@+id/roleGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/txtHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="选择身份进入"
                            android:textColor="#666666"
                            android:textSize="14sp"
                            android:layout_marginBottom="12dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEnterLeader"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="8dp"
                            android:text="进入领队端"
                            android:textSize="14sp"
                            app:cornerRadius="24dp"
                            app:iconGravity="textStart"
                            android:textColor="#333333"
                            app:backgroundTint="#EDEFF5"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEnterUser"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="进入用户端"
                            android:textSize="14sp"
                            app:cornerRadius="24dp"
                            app:iconGravity="textStart"
                            android:textColor="#333333"
                            app:backgroundTint="#EDEFF5"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/autoLoginRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:background="?attr/selectableItemBackground">

                        <CheckBox
                            android:id="@+id/autoLogin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:clickable="false"
                            android:focusable="false"
                            android:text="自动登录"
                            android:textColor="#666666"
                            android:textSize="14sp"
                            android:buttonTint="#4ED7A1" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 注册提�� -->
            <TextView
                android:id="@+id/btnRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="没有账号？点此注册"
                android:textColor="#1A73E8"
                android:textSize="14sp"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:layout_gravity="center_horizontal"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

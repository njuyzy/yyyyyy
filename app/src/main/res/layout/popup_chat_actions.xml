<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#D8DEE8" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="新建"
        android:textColor="#12263A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddFriend"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:gravity="start|center_vertical"
        android:paddingStart="8dp"
        android:text="添加好友"
        android:textColor="#12263A"
        android:textSize="16sp"
        app:icon="@drawable/baseline_person_add_24"
        app:iconGravity="start"
        app:iconPadding="16dp"
        app:iconTint="@color/chat_send_btn" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreateGroup"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="start|center_vertical"
        android:paddingStart="8dp"
        android:text="创建群聊"
        android:textColor="#12263A"
        android:textSize="16sp"
        app:icon="@drawable/baseline_group_add_24"
        app:iconGravity="start"
        app:iconPadding="16dp"
        app:iconTint="@color/chat_send_btn" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnJoinGroup"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="start|center_vertical"
        android:paddingStart="8dp"
        android:text="加入群聊"
        android:textColor="#12263A"
        android:textSize="16sp"
        app:icon="@drawable/baseline_groups_24"
        app:iconGravity="start"
        app:iconPadding="16dp"
        app:iconTint="@color/chat_send_btn" />
</LinearLayout>
